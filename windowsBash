#!/usr/bin/env bash
set -Eeuo pipefail

# ============================================================
# windowsBash
#
# Genera wrapper .cmd per usare i comandi Linux direttamente
# da CMD / Windows:
#
#   C:\Users\nando\Desktop>ls
#   D:\Desktop\TPSEE>grep ...
#   E:\Progetti>python3 ...
#
# Compatibile con:
#   - WSL1
#   - WSL2
#   - WSL Store
#   - wsl.exe in System32
#   - wsl.exe in Program Files\WSL
#   - più drive Windows
#
# NON dipende da Ubuntu.exe.
# NON hardcoda C:\Program Files\WSL\wsl.exe.
# ============================================================


# ------------------------------------------------------------
# Configurazione
# ------------------------------------------------------------

WINDOWS_DRIVE="C"
WINDOWS_DIR="/mnt/c/windowsBash"

RUNNER_DIR="/usr/local/libexec"
RUNNER="$RUNNER_DIR/windowsbash-runner"


# ------------------------------------------------------------
# Utente Linux reale
# ------------------------------------------------------------

if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
    LINUX_USER="$SUDO_USER"
else
    LINUX_USER="$(id -un)"
fi

LINUX_HOME="$(getent passwd "$LINUX_USER" | cut -d: -f6)"

if [[ -z "$LINUX_HOME" ]]; then
    echo "windowsBash: impossibile determinare HOME di $LINUX_USER" >&2
    exit 1
fi


# ------------------------------------------------------------
# sudo abstraction
# ------------------------------------------------------------

if [[ "$EUID" -eq 0 ]]; then
    SUDO=()
else
    SUDO=(sudo)
fi


echo
echo "============================================================"
echo " windowsBash"
echo "============================================================"
echo
echo "Utente Linux : $LINUX_USER"
echo "Home Linux   : $LINUX_HOME"
echo "Destinazione : C:\\windowsBash"
echo


# ============================================================
# Assicura che C: sia disponibile durante l'installazione
# ============================================================

if ! mountpoint -q /mnt/c 2>/dev/null; then

    echo "[*] Mount C: -> /mnt/c"

    "${SUDO[@]}" mkdir -p /mnt/c

    "${SUDO[@]}" mount -t drvfs C: /mnt/c || {
        echo "windowsBash: impossibile montare C:" >&2
        exit 1
    }

fi


mkdir -p "$WINDOWS_DIR"


# ============================================================
# RUNNER LINUX
#
# Viene sempre avviato da:
#
#   wsl.exe --cd / --user root
#
# Quindi wsl.exe NON tenta mai di tradurre direttamente:
#
#   D:\Desktop
#
# Sarà questo script a trasformarlo in:
#
#   /mnt/d/Desktop
# ============================================================

TMP_RUNNER="$(mktemp)"

cat > "$TMP_RUNNER" <<'RUNNER_EOF'
#!/usr/bin/env bash
set -uo pipefail


# ============================================================
# ARGOMENTI INTERNI
# ============================================================

LINUX_USER="$1"
COMMAND="$2"
WINDOWS_CWD="$3"

shift 3


die()
{
    echo "windowsBash: $*" >&2
    exit 1
}


# ============================================================
# UTENTE
# ============================================================

USER_ENTRY="$(getent passwd "$LINUX_USER")"

[[ -n "$USER_ENTRY" ]] ||
    die "utente Linux inesistente: $LINUX_USER"

LINUX_HOME="$(printf '%s' "$USER_ENTRY" | cut -d: -f6)"
LINUX_SHELL="$(printf '%s' "$USER_ENTRY" | cut -d: -f7)"

[[ -n "$LINUX_HOME" ]] ||
    LINUX_HOME="/home/$LINUX_USER"

[[ -n "$LINUX_SHELL" ]] ||
    LINUX_SHELL="/bin/bash"


# ============================================================
# CONTROLLA SE UN MOUNTPOINT È GIÀ MONTATO
# ============================================================

is_mounted()
{
    local mp="$1"

    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$mp" 2>/dev/null
        return $?
    fi

    grep -qs " $mp " /proc/mounts
}


# ============================================================
# MONTA AUTOMATICAMENTE DRIVE WINDOWS
#
# D:
#
# diventa
#
# /mnt/d
# ============================================================

mount_windows_drive()
{
    local drive="$1"

    local upper
    local lower
    local mp

    upper="$(printf '%s' "$drive" |
             tr '[:lower:]' '[:upper:]')"

    lower="$(printf '%s' "$drive" |
             tr '[:upper:]' '[:lower:]')"

    mp="/mnt/$lower"

    if is_mounted "$mp"; then
        return 0
    fi

    mkdir -p "$mp"

    mount -t drvfs "${upper}:" "$mp" >/dev/null 2>&1 || {
        die "impossibile montare ${upper}: su $mp"
    }
}


# ============================================================
# WINDOWS PATH -> WSL PATH
#
# D:\Desktop\TPSEE
#
# ->
#
# /mnt/d/Desktop/TPSEE
# ============================================================

windows_to_linux()
{
    local win="$1"

    local drive
    local rest

    # Path assoluto con drive Windows
    if [[ "$win" =~ ^([A-Za-z]):([\\/].*)?$ ]]; then

        drive="${BASH_REMATCH[1]}"
        rest="${BASH_REMATCH[2]:-}"

        mount_windows_drive "$drive"

        drive="$(printf '%s' "$drive" |
                 tr '[:upper:]' '[:lower:]')"

        # backslash -> slash
        rest="${rest//\\//}"

        printf '/mnt/%s%s' "$drive" "$rest"

        return 0
    fi

    return 1
}


# ============================================================
# CONVERTE CURRENT WORKING DIRECTORY
# ============================================================

LINUX_CWD="$(windows_to_linux "$WINDOWS_CWD")" || {
    die "path Windows non riconosciuto: $WINDOWS_CWD"
}


[[ -d "$LINUX_CWD" ]] || {
    die "directory inesistente: $LINUX_CWD"
}


cd -- "$LINUX_CWD" || {
    die "impossibile entrare in $LINUX_CWD"
}


# ============================================================
# CONVERTE ANCHE GLI ARGOMENTI WINDOWS ASSOLUTI
#
# cat D:\Desktop\a.txt
#
# ->
#
# cat /mnt/d/Desktop/a.txt
# ============================================================

ARGS=()

for ARG in "$@"; do

    if CONVERTED="$(windows_to_linux "$ARG" 2>/dev/null)"; then
        ARGS+=("$CONVERTED")
    else
        ARGS+=("$ARG")
    fi

done


# ============================================================
# VERIFICA COMANDO
# ============================================================

[[ -x "$COMMAND" ]] || {
    die "comando Linux non eseguibile: $COMMAND"
}


# ============================================================
# ENVIRONMENT UTENTE
#
# Il mount è stato eseguito come root.
# Il programma finale NON viene eseguito come root.
# ============================================================

export HOME="$LINUX_HOME"
export USER="$LINUX_USER"
export LOGNAME="$LINUX_USER"
export SHELL="$LINUX_SHELL"

export PATH="$LINUX_HOME/.local/bin:$LINUX_HOME/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


# ============================================================
# DROP PRIVILEGES
# ============================================================

if [[ "$LINUX_USER" == "root" ]]; then

    "$COMMAND" "${ARGS[@]}"
    exit $?

fi


if ! command -v runuser >/dev/null 2>&1; then
    die "runuser non trovato"
fi


runuser \
    --preserve-environment \
    -u "$LINUX_USER" \
    -- \
    "$COMMAND" "${ARGS[@]}"

exit $?

RUNNER_EOF


"${SUDO[@]}" mkdir -p "$RUNNER_DIR"

"${SUDO[@]}" install \
    -m 755 \
    "$TMP_RUNNER" \
    "$RUNNER"

rm -f "$TMP_RUNNER"


echo "[+] Runner installato:"
echo "    $RUNNER"
echo


# ============================================================
# PULIZIA WRAPPER PRECEDENTI
# ============================================================

echo "[*] Pulizia vecchi wrapper..."

rm -f "$WINDOWS_DIR"/*.cmd


# ============================================================
# DIRECTORY LINUX DA ESPORTARE
#
# L'ordine determina la precedenza.
# ============================================================

SEARCH_DIRS=()

[[ -d "$LINUX_HOME/.local/bin" ]] &&
    SEARCH_DIRS+=("$LINUX_HOME/.local/bin")

[[ -d "$LINUX_HOME/bin" ]] &&
    SEARCH_DIRS+=("$LINUX_HOME/bin")

SEARCH_DIRS+=(
    "/usr/local/bin"
    "/usr/bin"
    "/bin"
)

[[ -d /snap/bin ]] &&
    SEARCH_DIRS+=("/snap/bin")


# ============================================================
# Nomi Windows validi
# ============================================================

windows_filename_valid()
{
    local name="$1"
    local lower="${name,,}"

    # caratteri sicuri
    [[ "$name" =~ ^[A-Za-z0-9._+@=-]+$ ]] ||
        return 1

    # Windows non gradisce il punto finale
    [[ "$name" != *. ]] ||
        return 1

    # device names riservati Windows
    case "$lower" in

        con|prn|aux|nul)
            return 1
            ;;

        com[1-9]|lpt[1-9])
            return 1
            ;;

    esac

    return 0
}


# ============================================================
# GENERAZIONE
# ============================================================

declare -A SEEN

COUNT=0
SKIPPED=0


echo "[*] Generazione wrapper..."
echo


for DIR in "${SEARCH_DIRS[@]}"; do

    [[ -d "$DIR" ]] || continue

    for ENTRY in "$DIR"/*; do

        # file/symlink eseguibile
        [[ -e "$ENTRY" ]] || continue
        [[ -x "$ENTRY" ]] || continue
        [[ ! -d "$ENTRY" ]] || continue

        FILENAME="${ENTRY##*/}"

        windows_filename_valid "$FILENAME" || {
            ((SKIPPED+=1))
            continue
        }

        # Windows è case insensitive
        KEY="${FILENAME,,}"

        if [[ -n "${SEEN[$KEY]:-}" ]]; then
            continue
        fi

        SEEN["$KEY"]=1


        CMD_FILE="$WINDOWS_DIR/$FILENAME.cmd"


        # ====================================================
        # IMPORTANTE:
        #
        # Ogni wrapper cerca wsl.exe A RUNTIME.
        #
        # Quindi funziona se WSL è:
        #
        # C:\Windows\System32\wsl.exe
        # C:\Program Files\WSL\wsl.exe
        # WindowsApps
        # oppure qualsiasi wsl.exe presente nel PATH.
        # ====================================================

        cat > "$CMD_FILE" <<EOF
@echo off
setlocal EnableExtensions DisableDelayedExpansion

set "WSL="

REM ==========================================================
REM 1. Cerca wsl.exe nel PATH della macchina corrente
REM ==========================================================

for /f "delims=" %%W in ('where.exe wsl.exe 2^>nul') do (
    if not defined WSL set "WSL=%%W"
)


REM ==========================================================
REM 2. Fallback: Sysnative
REM    Utile con processi Windows a 32 bit su Windows 64 bit
REM ==========================================================

if not defined WSL (
    if exist "%SystemRoot%\Sysnative\wsl.exe" (
        set "WSL=%SystemRoot%\Sysnative\wsl.exe"
    )
)


REM ==========================================================
REM 3. Fallback standard Windows
REM ==========================================================

if not defined WSL (
    if exist "%SystemRoot%\System32\wsl.exe" (
        set "WSL=%SystemRoot%\System32\wsl.exe"
    )
)


REM ==========================================================
REM 4. Fallback nuova installazione WSL
REM ==========================================================

if not defined WSL (
    if exist "%ProgramFiles%\WSL\wsl.exe" (
        set "WSL=%ProgramFiles%\WSL\wsl.exe"
    )
)


REM ==========================================================
REM 5. Fallback WindowsApps
REM ==========================================================

if not defined WSL (
    if exist "%LOCALAPPDATA%\Microsoft\WindowsApps\wsl.exe" (
        set "WSL=%LOCALAPPDATA%\Microsoft\WindowsApps\wsl.exe"
    )
)


REM ==========================================================
REM Nessun WSL trovato
REM ==========================================================

if not defined WSL (
    echo windowsBash: wsl.exe non trovato. 1>&2
    echo windowsBash: controllare l'installazione di WSL. 1>&2

    endlocal
    exit /b 127
)


REM ==========================================================
REM WSL parte SEMPRE da /
REM
REM Evita:
REM
REM   wsl: Failed to translate 'D:\Desktop'
REM ==========================================================

"%WSL%" --cd / --user root --exec "$RUNNER" "$LINUX_USER" "$ENTRY" "%CD%" %*

set "RC=%ERRORLEVEL%"

endlocal & exit /b %RC%
EOF


        ((COUNT+=1))

    done

done


# ============================================================
# DIAGNOSTICA WINDOWS
# ============================================================

cat > "$WINDOWS_DIR/windowsBash-doctor.cmd" <<'EOF'
@echo off
setlocal EnableExtensions DisableDelayedExpansion

echo.
echo ============================================================
echo  windowsBash doctor
echo ============================================================
echo.

echo Current directory:
echo   %CD%
echo.

echo Cerca wsl.exe:
where wsl.exe 2>nul

echo.

if exist "%SystemRoot%\System32\wsl.exe" (
    echo System32:
    echo   %SystemRoot%\System32\wsl.exe
)

if exist "%ProgramFiles%\WSL\wsl.exe" (
    echo Program Files:
    echo   %ProgramFiles%\WSL\wsl.exe
)

if exist "%LOCALAPPDATA%\Microsoft\WindowsApps\wsl.exe" (
    echo WindowsApps:
    echo   %LOCALAPPDATA%\Microsoft\WindowsApps\wsl.exe
)

echo.
echo Distribuzioni:
echo.

wsl.exe -l -v

echo.
echo Test WSL:
echo.

wsl.exe --cd / --exec /usr/bin/uname -a

echo.
echo ============================================================

endlocal
EOF


# ============================================================
# RISULTATO
# ============================================================

echo
echo "============================================================"
echo " windowsBash installato"
echo "============================================================"
echo
echo "Wrapper creati : $COUNT"
echo "Saltati        : $SKIPPED"
echo
echo "Directory:"
echo "  C:\\windowsBash"
echo
echo "Runner:"
echo "  $RUNNER"
echo
echo "Utente:"
echo "  $LINUX_USER"
echo
echo "IMPORTANTE:"
echo "  aggiungi C:\\windowsBash al PATH di Windows."
echo
echo "Diagnostica:"
echo "  windowsBash-doctor"
echo
echo "============================================================"
echo